table gold_loan_summary
	lineageTag: bc47a45d-5a76-4e9f-b6e4-a663cddb0796
	sourceLineageTag: [dbo].[gold_loan_summary]

	measure 'Default Rate' =
			
			DIVIDE(SUM(gold_loan_summary[is_default]), COUNTROWS(gold_loan_summary))
		lineageTag: a301edbb-6a6b-45c7-b4d4-565b805af3d8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Interest Yield' =
			
			CALCULATE(
			    AVERAGE(gold_loan_summary[int_rate]),
			    gold_loan_summary[loan_status_std] <> "Defaulted"
			)
		lineageTag: 79e7ae3a-e26b-495a-b5ad-b1dace93bd39

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recovery Rate' =
			
			DIVIDE(
			    SUM(gold_loan_summary[recoveries]),
			    SUMX(FILTER(gold_loan_summary, [is_default] = 1), [funded_amnt])
			)
		lineageTag: da45493d-67b2-40c4-926e-e2927b7224a6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Funded' =
			
			SUM(gold_loan_summary[funded_amnt])
		lineageTag: ffae51f7-00ae-4ae7-aee7-ca63dddb4b4d

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

