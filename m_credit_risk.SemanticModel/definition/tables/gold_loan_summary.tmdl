table gold_loan_summary
	lineageTag: d50499a0-f4f6-409b-a8a2-333ce75b3413
	sourceLineageTag: [dbo].[gold_loan_summary]

	measure 'Total Funded' =
			
			SUM(gold_loan_summary[funded_amnt])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ca8cf37f-db05-45ee-b0cf-682634f82c1c

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Default Rate' =
			
			DIVIDE(
			    SUM(gold_loan_summary[is_default]),
			    SUM(gold_loan_summary[is_completed])    -- only completed loans (not 'Current')
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9aefa94c-33c1-4654-b204-e2260d7e96cd

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

	measure 'Avg Interest Yield' =
			
			CALCULATE(
			    AVERAGE(gold_loan_summary[int_rate]),
			    gold_loan_summary[loan_status_std] <> "Defaulted"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f8244654-38fd-4492-ae48-bf68863ed3b7

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

	measure 'Recovery Rate' =
			
			DIVIDE(
			    SUM(gold_loan_summary[recoveries]),
			    SUMX(FILTER(gold_loan_summary, [is_default] = 1), [funded_amnt])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c77130e0-27d4-4305-a553-85f0b399f567

		changedProperty = Name

		changedProperty = IsHidden

		changedProperty = FormatString

